GEMINI_API_KEY=your_gemini_api_key_here
# Ceren 5'li hukuk içeriği: Gemini → generated-articles/, ardından site verisi
# npm run content:legal:sync
# Yeniden üret (üzerine yaz) + yayın: npm run content:legal:sync:force
# Sadece üret: npm run content:gemini:ceren-5  |  Sadece yayın: npm run content:legal:publish
# DALL-E 3 kapak gorselleri (content_manager) icin
OPENAI_API_KEY=""
# Python otomasyonu (crawler / content_manager) icin, virgulle ayirilmis RSS URL'leri
RSS_FEEDS=""
# Isteg bagli: gemini-3-flash, gemini-2.0-flash vb. (Hesabinizda acik olan model)
GEMINI_MODEL="gemini-3-flash"
ADMIN_PASSWORD=123456
NEXT_PUBLIC_SITE_URL="https://ornekdomain.com"
GOOGLE_SITE_VERIFICATION=""
GEMINI_GOOGLE_SEARCH_ENABLED=true
